<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.sm.lab</groupId>
  <artifactId>shop-api</artifactId>
  <version>0.1.0</version>
  <name>sl-shop-api</name>
  <description>Speclinker 실증 랩 — 이커머스 쇼핑몰(상품·장바구니·주문·회원) (Spring Boot + MyBatis + Thymeleaf)</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
    </dependency>
    <!-- linked_func: FUNC-member-003 — SR-231 가입 요청 API 비밀번호 해시(BCrypt)용. STORY
         "승인된 설계 확정" 지시대로 spring-security-crypto만 추가하고, 인증/인가 체계 전체를
         끌어들이는 spring-boot-starter-security는 추가하지 않는다(이 랩은 별도 인증 미들웨어
         없이 ApiKeyAuthFilter만 사용 — project-context.md 인증/권한 처리 패턴 참고). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- linked_func: FUNC-order-007 — 테스트 인프라 부재로 신규 추가(TDD 전제조건) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- linked_func: FUNC-member-001 — round2 재작업 지시(사람 승인, STORY-FUNC-member-001.md
         "테스트" 코멘트): signup.html의 클라이언트 상태 전이(§5 9개 상태)를 실제 JS 실행
         환경에서 단언하기 위해 추가. spring-boot-dependencies 3.3.5가 버전을 관리한다
         (htmlunit.version=2.70.0) — 이 프로젝트 최초의 HtmlUnit 사용이다.
         websocket-client(→jetty-client 12.x)는 이 화면이 WebSocket을 쓰지 않아 불필요할 뿐
         아니라, Spring의 TestRestTemplate이 그 jetty-client를 골라 써 ApiKeyAuthIntegrationTest의
         401(WWW-Authenticate 헤더 없음) 응답 처리를 깨뜨리는 실측 회귀를 냈다(mvnw test 전체
         실행에서 확인 — Jetty 클라이언트가 "Authentication challenge without WWW-Authenticate
         header"를 프로토콜 위반으로 취급). 이 FUNC 밖(ApiKeyAuthFilter, FUNC-order-001 소유)
         테스트를 건드리지 않기 위해 제외한다. -->
    <dependency>
      <groupId>net.sourceforge.htmlunit</groupId>
      <artifactId>htmlunit</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.eclipse.jetty.websocket</groupId>
          <artifactId>websocket-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- SR-301(INF-ORD-017) — shop-web(SPA) 빌드 산출물(dist)을 target/classes/static/shop 밑으로
           복사해 ShopStaticResourceConfig의 기본 위치(classpath:/static/shop/)가 그대로 이를 참조하게
           한다. src/main/resources(소스 트리)는 건드리지 않으므로 .gitignore 변경도 불필요(target/은
           이미 무시 대상). generate-resources는 기본 라이프사이클상 process-resources(src/main/resources
           → target/classes 복사)보다 먼저 실행되어 순서 충돌(덮어쓰기)이 없다. shop-web/dist가 아직
           없는 로컬/CI 환경에서도(존재하지 않는 resource 디렉터리는 이 플러그인이 조용히 건너뛴다)
           빌드·기동이 실패하지 않는다 — AC "빌드 산출물이 없어도 기동은 성공"을 만족한다. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-shop-spa-dist</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static/shop</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../shop-web/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- linked_func: FUNC-member-002 — round6(SR-231 round5 QA CONCERNS 재작업 지시 2,
           사람 결정). MemberSignupMaintenanceScheduler(@Scheduled)가 테스트 컨텍스트에서
           기동되지 않게 막는다. spring.task.scheduling.enabled는 Spring Boot가 공식
           인식하는 프로퍼티가 아니라(TaskSchedulingProperties에 그런 필드가 없다) 이 값
           자체는 원래 아무 효과가 없다 — com.sm.lab.shop.service.MemberSignupSchedulingConfig의
           @ConditionalOnProperty가 정확히 이 키를 읽어 스케줄러 @Configuration 자체를
           걸러내는 방식으로 "실제 효과"를 부여한다. system property는 application 설정
           파일보다 우선순위가 높아 application.yml을 건드리지 않고도(이 모듈의 다른
           @SpringBootTest 15개가 쓰는 datasource/mybatis 설정을 그대로 둔 채) 이 모듈의
           모든 테스트 JVM에 적용된다. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.task.scheduling.enabled>false</spring.task.scheduling.enabled>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
